# AIOS — hito 0 · Buildroot 2026.08.1 · x86_64
# Imagen de disco (USB/QEMU) BIOS + UEFI · systemd · Wayland (sway + foot) · llama.cpp

# --- Arquitectura y toolchain -----------------------------------------------
# x86-64 base: arranca en cualquier PC de 64 bits. La velocidad de la IA la da
# llama.cpp eligiendo su variante de CPU en tiempo de ejecución (external.mk).
BR2_x86_64=y
BR2_x86_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_CCACHE=y
# Compilación paralela de alto nivel: varios paquetes a la vez (make -jN).
BR2_PER_PACKAGE_DIRECTORIES=y

# --- Sistema ----------------------------------------------------------------
BR2_TARGET_GENERIC_HOSTNAME="aios"
BR2_TARGET_GENERIC_ISSUE="AIOS"
BR2_TARGET_GENERIC_ROOT_PASSWD="aios"
BR2_INIT_SYSTEMD=y
BR2_SYSTEM_BIN_SH_BASH=y
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
BR2_ENABLE_LOCALE_WHITELIST="C en_US es_ES fr_FR de_DE it_IT pt_PT ca_ES"
BR2_GENERATE_LOCALE="en_US.UTF-8 es_ES.UTF-8 fr_FR.UTF-8 de_DE.UTF-8 it_IT.UTF-8 pt_PT.UTF-8 ca_ES.UTF-8"
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Europe/Madrid"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_AIOS_PATH)/board/aios/busybox.fragment"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_AIOS_PATH)/board/aios/users.txt"
BR2_ROOTFS_DEVICE_TABLE="system/device_table.txt $(BR2_EXTERNAL_AIOS_PATH)/board/aios/permissions.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_AIOS_PATH)/board/aios/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_AIOS_PATH)/board/aios/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_AIOS_PATH)/board/aios/post-image.sh"

# --- Kernel: 6.18 LTS (la versión validada en los dos portátiles con aios-lfs)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.10"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_AIOS_PATH)/board/aios/kernel/kernel_base.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_AIOS_PATH)/board/aios/kernel/aios.fragment"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# --- Firmware: GPU, wifi y red de los portátiles habituales ------------------
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_I915=y
BR2_PACKAGE_LINUX_FIRMWARE_XE=y
BR2_PACKAGE_LINUX_FIRMWARE_AMDGPU=y
BR2_PACKAGE_LINUX_FIRMWARE_RADEON=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7265D=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8265=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_9XXX=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_22000=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_QUZ=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW89=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_10K_QCA9377=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XX=y

# --- systemd ----------------------------------------------------------------
BR2_PACKAGE_SYSTEMD_LOGIND=y
# Guarda el brillo de la pantalla al apagar y lo restaura al arrancar
BR2_PACKAGE_SYSTEMD_BACKLIGHT=y
# PAM con pam_systemd: sin él el login no abre sesión en logind y sway no
# consigue asiento (libseat: "Could not get primary session").
BR2_PACKAGE_LINUX_PAM=y
BR2_PACKAGE_UTIL_LINUX_LOGIN=y
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y
BR2_PACKAGE_SYSTEMD_TIMESYNCD=y
BR2_PACKAGE_SYSTEMD_HOSTNAMED=y
BR2_PACKAGE_SYSTEMD_SYSEXT=y
BR2_PACKAGE_SYSTEMD_VCONSOLE=y

# --- Utilidades básicas -----------------------------------------------------
BR2_PACKAGE_BASH=y
BR2_PACKAGE_KBD=y
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_SUDO=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_OPENSSH=y
# 'aios update code': actualiza scripts y configuración desde el repositorio
BR2_PACKAGE_GIT=y
BR2_PACKAGE_ZSTD=y

# --- Red: cable con networkd, wifi con iwd ----------------------------------
BR2_PACKAGE_IWD=y
BR2_PACKAGE_IPROUTE2=y

# --- Gráficos: Wayland (sway + foot) ----------------------------------------
# wlroots puede dibujar sin GPU (renderizador pixman): sirve en GPU viejas
# sin driver 3D y en QEMU.
BR2_PACKAGE_MESA3D=y
# Con LLVM: iris y crocus (Intel) lo exigen en mesa 26, igual que radeonsi.
# Buildroot descarta iris sin avisar si falta LLVM: comprobar build/output/.config.
# Sin driver para la GPU, mesa cae a llvmpipe, wlroots lo rechaza por ser
# software y aios-session reintenta con pixman.
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_CROCUS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_R600=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_NOUVEAU=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_SEATD=y

# --- Sonido: PipeWire para todas las aplicaciones -------------------------------
# Nativas (PipeWire), ALSA (pipewire-alsa: dispositivo "default") y PulseAudio
# (pipewire-pulse; libpulse de pulseaudio para las apps que la cargan, sin su
# demonio). WirePlumber gestiona dispositivos. SOF + UCM: el DSP y los
# micrófonos digitales de los portátiles Intel (el HP 15s es Ice Lake).
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_LIB_UCM=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_ALSAUCM=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
BR2_PACKAGE_ALSA_UCM_CONF=y
BR2_PACKAGE_SOF_BIN=y
BR2_PACKAGE_PIPEWIRE=y
BR2_PACKAGE_LIBSNDFILE=y
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_4=y
BR2_PACKAGE_WIREPLUMBER=y
BR2_PACKAGE_PULSEAUDIO=y

# --- Voz y pantalla: reconocimiento (whisper), síntesis (espeak), capturas ------
BR2_PACKAGE_WHISPER_CPP=y
BR2_PACKAGE_ESPEAK=y
BR2_PACKAGE_ESPEAK_AUDIO_BACKEND_NONE=y
BR2_PACKAGE_GRIM=y

# --- Escritorio: bloqueo, inactividad, notificaciones, varias pantallas ----------
BR2_PACKAGE_SWAYLOCK=y
BR2_PACKAGE_SWAYIDLE=y
BR2_PACKAGE_MAKO=y
BR2_PACKAGE_WL_MIRROR=y

# --- Bluetooth: auriculares y altavoces (PipeWire), teclados y ratones ------------
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_AUDIO=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HOG=y
# Sin SBC, PipeWire se compila sin Bluetooth (pipewire.mk pide bluez5 + sbc + glib)
BR2_PACKAGE_SBC=y
BR2_PACKAGE_LINUX_FIRMWARE_IBT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_QUALCOMM_9377_BT=y
BR2_PACKAGE_SWAY=y
BR2_PACKAGE_SWAY_SWAYBAR=y
BR2_PACKAGE_FOOT=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y

# --- Python (agente y CLI aios) ---------------------------------------------
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_PYC=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_READLINE=y
BR2_PACKAGE_PYTHON3_SQLITE=y
BR2_PACKAGE_PYTHON3_ZLIB=y

# --- IA local ---------------------------------------------------------------
BR2_PACKAGE_LLAMA_CPP=y
BR2_PACKAGE_LLAMA_CPP_TOOLS=y

# --- Arranque: GRUB para BIOS y UEFI (configuración probada en newos) -------
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_BOOT_PARTITION="hd0,msdos1"
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="boot linux ext2 fat part_msdos part_gpt normal biosdisk search search_fs_file test"
BR2_TARGET_GRUB2_BUILTIN_CONFIG_PC="$(BR2_EXTERNAL_AIOS_PATH)/board/aios/grub-embed.cfg"
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat part_msdos part_gpt normal efi_gop search search_fs_file test"
BR2_TARGET_GRUB2_BUILTIN_CONFIG_EFI="$(BR2_EXTERNAL_AIOS_PATH)/board/aios/grub-embed.cfg"

# --- Imágenes ---------------------------------------------------------------
# Raíz ext4 de 7 GB: cabe el modelo (~3,4 GB con visión) en el hito 0.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_LABEL="aios-root"
BR2_TARGET_ROOTFS_EXT2_SIZE="7168M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y

# --- Proveedores de IA: emparejamiento (aios ai pair) ----------------------------
# La clave se pega en el móvil o el PC; el navegador la cifra con la clave pública
# que genera el portátil (openssl) y el VPS solo ve texto cifrado. QR en la terminal.
BR2_PACKAGE_LIBOPENSSL_BIN=y
BR2_PACKAGE_LIBQRENCODE=y
BR2_PACKAGE_LIBQRENCODE_TOOLS=y

# --- Cortafuegos: nada entra salvo respuestas (aios-firewall) ---------------------
BR2_PACKAGE_NFTABLES=y
