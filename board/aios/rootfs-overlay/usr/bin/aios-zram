#!/bin/sh
# AIOS — swap comprimida en RAM (zram), la mitad de la memoria y como mucho 8 GiB.
# El modelo ocupa ~6 GiB de 8 y no hay partición de swap: sin esto, cuando se
# llena la memoria el sistema se congela o el kernel mata algo a lo bruto. La
# memoria poco usada se comprime (~2:1) en vez de perderse.
# aios-zram start | stop   (lo llama aios-zram.service)
set -e
dev=/sys/block/zram0
case "$1" in
start)
    [ -e /etc/aios/zram.disable ] && { echo "aios-zram: disabled"; exit 0; }
    modprobe zram num_devices=1
    [ "$(cat $dev/disksize)" = 0 ] || { echo "aios-zram: already set up"; exit 0; }
    mem_kib=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
    size_kib=$((mem_kib / 2))
    [ $size_kib -le 8388608 ] || size_kib=8388608
    echo "${size_kib}K" > $dev/disksize
    mkswap /dev/zram0 >/dev/null
    swapon -p 100 /dev/zram0
    echo "aios-zram: $((size_kib / 1024)) MiB, $(cat $dev/comp_algorithm | sed 's/.*\[\(.*\)\].*/\1/')"
    ;;
stop)
    swapoff /dev/zram0 2>/dev/null || true
    [ -e $dev/reset ] && echo 1 > $dev/reset
    ;;
*)
    echo "usage: aios-zram start|stop" >&2
    exit 2
    ;;
esac
