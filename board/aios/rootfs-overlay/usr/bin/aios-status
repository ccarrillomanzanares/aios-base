#!/usr/bin/env python3
"""AIOS — línea de estado de swaybar: modelo, red, batería, RAM libre y hora.

Un solo proceso que se queda vivo (no lanza un intérprete cada 5 s). La red
sale de aios.net, el mismo código que 'aios net status'. AIOS_SYSFS cambia la
raíz de /sys para las pruebas.
"""
import glob
import locale
import os
import signal
import subprocess
import sys
import time
import urllib.request

sys.path.insert(0, os.environ.get("AIOS_LIB", "/usr/lib/aios"))
from aios import ai as aiconf, audio, net, notify, voice  # noqa: E402

SYSFS = os.environ.get("AIOS_SYSFS", "/sys")
LLAMA = "http://127.0.0.1:{}/health".format(os.environ.get("AIOS_LLAMA_PORT", "8083"))


def ai():
    p = aiconf.provider()
    if not p["local"]:  # que se vea que las conversaciones salen del equipo
        ok, _ = aiconf.reachable(p)
        return f'AI REMOTE {p["name"].upper()}' + ("" if ok else " DOWN")
    try:
        with urllib.request.urlopen(LLAMA, timeout=1) as r:
            if r.status == 200:
                return "AI ONLINE"
    except OSError:
        pass
    rc = subprocess.run(["systemctl", "-q", "is-active", "aios-llama.service"]).returncode
    return "AI LOADING" if rc == 0 else "AI OFFLINE"


def network():
    try:
        ifaces = net.status(check_internet=False).data.get("interfaces", [])
    except Exception:
        return "NET ?"
    for i in ifaces:  # wifi conectado primero, luego cable con dirección
        if i["type"] == "wifi" and i.get("ssid") and i["ipv4"]:
            return f'WIFI {i["ssid"]}'
    for i in ifaces:
        if i["type"] == "ethernet" and i["ipv4"]:
            return "ETH"
    return "NET OFF"


ALERTED = {}  # batería -> último umbral avisado (10, 5)


def battery_alert(name, cap, st):
    """Aviso de batería baja: notificación y en voz alta, una vez por umbral."""
    if st == "Charging" or cap > 15:
        ALERTED.pop(name, None)
        return
    for level, urgency in ((5, "critical"), (10, "normal")):
        if cap <= level and ALERTED.get(name, 100) > level:
            ALERTED[name] = level
            notify.send(f"Battery low: {cap}%", "Plug in the charger.", urgency)
            lang = os.environ.get("LANG", "en")[:2]
            voice.speak(f"Batería baja: {cap} por ciento." if lang == "es" else
                        f"Battery low: {cap} percent.", lang)
            break


def battery():
    out = []
    for bat in sorted(glob.glob(os.path.join(SYSFS, "class", "power_supply", "BAT*"))):
        try:
            cap = open(os.path.join(bat, "capacity")).read().strip()
            st = open(os.path.join(bat, "status")).read().strip()
        except OSError:
            continue
        mark = {"Charging": "+", "Full": ""}.get(st, "")
        try:
            battery_alert(bat, int(cap), st)
        except ValueError:
            pass
        out.append(f"BAT {cap}%{mark}")
    return " ".join(out)


def sound():
    try:
        v = audio.get_volume(audio.SINK)
    except Exception:
        return ""
    if v is None:
        return ""
    return "VOL MUTE" if v[1] else f"VOL {v[0]}%"


def mic():
    return "● REC" if voice.recording() else ""


class Refresh(Exception):
    """aios-voice y las teclas piden repintar ya (SIGUSR1), sin esperar 5 s."""


def on_refresh(signum, frame):
    raise Refresh


def mem_free():
    for line in open("/proc/meminfo"):
        if line.startswith("MemAvailable:"):
            return "RAM {:.1f}G free".format(int(line.split()[1]) / 1048576)
    return ""


def line():
    parts = [mic(), ai(), network(), sound(), battery(), mem_free(), time.strftime("%a %d %b %H:%M")]
    return " | ".join(p for p in parts if p)


def main():
    try:  # fecha en el idioma del sistema (jue 29 oct), como hacía 'date'
        locale.setlocale(locale.LC_TIME, "")
    except locale.Error:
        pass
    signal.signal(signal.SIGUSR1, on_refresh)
    while True:
        try:
            print(line(), flush=True)
            time.sleep(5)
        except Refresh:
            continue


if __name__ == "__main__":
    try:
        main()
    except (BrokenPipeError, KeyboardInterrupt):
        pass
