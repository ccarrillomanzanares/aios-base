#!/usr/bin/env python3
"""AIOS — instalador a disco. Se ejecuta desde el USB y BORRA EL DISCO ENTERO.

Disco resultante (MBR, como el USB: arranca igual en BIOS y en UEFI):
  sector 0      boot.img de GRUB (446 bytes; la tabla de particiones se respeta)
  sector 1..    núcleo de GRUB para BIOS (core-pc.img), en el hueco antes de la p1
  partición 1   ESP FAT32: EFI/BOOT/BOOTX64.EFI, aios/grub/grub.cfg y grubenv
  partición 2   raíz A (ext4): copia del sistema que corre en el USB
  partición 3   raíz B (ext4, vacía): para las actualizaciones A/B (hito 4)
  partición 4   /home cifrado (LUKS2); systemd-cryptsetup pide la frase al arrancar

La raíz no se cifra: AIOS arranca sin initramfs. El kernel se lee de
/boot/bzImage de la raíz activa, que elige la variable slot de grubenv.
Los núcleos de GRUB del disco (/usr/lib/aios/boot, de post-build.sh) buscan
/aios/grub/grub.cfg: no se confunden con el USB, que busca /boot/grub/grub.cfg.

Se copian el sistema y /home del USB tal como están: contraseña, idioma, wifi,
proveedores de IA e historial del chat siguen igual en el disco.

Uso: sudo aios-install                 (interactivo)
     sudo aios-install --list          (discos donde se puede instalar)
     sudo aios-install --disk /dev/sdX --confirm sdX --passphrase-file F
"""
import argparse
import getpass
import json
import os
import secrets
import shutil
import subprocess
import sys
import threading
import time

BOOT = os.environ.get("AIOS_INSTALL_BOOT", "/usr/lib/aios/boot")
WORK = "/run/aios-install"
INSTALL_INFO = "/etc/aios/install.conf"
GiB = 1024 ** 3
ESP_MIB = 256
MIN_DISK = 24 * 10 ** 9          # 24 GB: ESP + dos raíces de 8 GiB + /home
MIN_PASSPHRASE = 8
KERNEL_ARGS = "rootwait rw console=ttyS0,115200 console=tty1"


class InstallError(Exception):
    pass


def run(args, input=None):
    p = subprocess.run(args, input=input, capture_output=True, text=True)
    if p.returncode != 0:
        raise InstallError(f"{' '.join(args)}: {(p.stderr or p.stdout).strip()[-400:]}")
    return p.stdout


def step(text):
    print(f"  * {text}", flush=True)


# --- discos -------------------------------------------------------------------------

def source_disk():
    """Disco del que arranca el sistema que corre (el USB), por el dispositivo de /."""
    dev = os.stat("/").st_dev
    path = os.path.realpath(f"/sys/dev/block/{os.major(dev)}:{os.minor(dev)}")
    # /sys/devices/.../block/sda/sda2 -> sda; si / está en un disco sin particiones, el propio
    return os.path.basename(os.path.dirname(path)) if os.path.exists(f"{path}/partition") \
        else os.path.basename(path)


def disks():
    out = json.loads(run(["lsblk", "-J", "-b", "-o",
                          "NAME,PATH,SIZE,TYPE,MODEL,TRAN,RM,RO,FSTYPE,LABEL,MOUNTPOINTS"]))
    src = source_disk()
    res = []
    for d in out.get("blockdevices", []):
        if d.get("type") != "disk" or d["name"].startswith(("zram", "loop", "sr", "fd")):
            continue
        why = None
        if d["name"] == src:
            why = "AIOS is running from this disk"
        elif d.get("ro"):
            why = "read-only"
        elif int(d.get("size") or 0) < MIN_DISK:
            why = f"too small (needs {MIN_DISK // 10 ** 9} GB)"
        d["unusable"] = why
        res.append(d)
    return res


def human(n):
    n = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1000 or unit == "TB":
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1000


def describe(d):
    kind = {"usb": "USB", "nvme": "NVMe", "sata": "SATA", "ata": "ATA", "mmc": "SD/eMMC",
            "virtio": "virtio"}.get(d.get("tran") or "", d.get("tran") or "disk")
    return f"{d['name']}  {human(d['size'])}  {kind}  {(d.get('model') or '').strip()}"


def contents(d):
    """Lo que hay ahora en el disco, para el resumen de lo que se borra."""
    lines = []
    for c in d.get("children") or []:
        what = " ".join(x for x in (c.get("fstype"), c.get("label")) if x) or "unknown data"
        lines.append(f"      {c['name']}  {human(c['size'])}  {what}")
    return lines or ["      (no partitions found)"]


def parts_of(path):
    """Particiones del disco en orden, cuando udev ya las ha creado."""
    return lsblk_list(path, "part")


def lsblk_list(path, kind):
    """Dispositivos de un tipo bajo path (lsblk anida o no según el tipo de disco)."""
    rows = (l.split() for l in run(["lsblk", "-ln", "-o", "PATH,TYPE", path]).splitlines())
    return [r[0] for r in rows if len(r) == 2 and r[1] == kind]


def free_disk(d):
    """Desmonta lo que el sistema tenga abierto de ese disco (swap, montajes, LUKS)."""
    for c in d.get("children") or []:
        for mp in c.get("mountpoints") or []:
            if mp:
                subprocess.run(["umount", "-R", mp], capture_output=True)
        for h in lsblk_list(c["path"], "crypt"):
            subprocess.run(["umount", h], capture_output=True)
            subprocess.run(["cryptsetup", "close", h], capture_output=True)
        subprocess.run(["swapoff", c["path"]], capture_output=True)


# --- pasos de la instalación -------------------------------------------------------------

def slot_size(size):
    """Cada raíz: 1/8 del disco entre 8 y 16 GiB (la del USB es de 7)."""
    return max(8 * GiB, min(16 * GiB, size // 8 // GiB * GiB))


def partition(path, size):
    sig = secrets.randbits(32) | 1
    root = slot_size(size) // (1024 * 1024)
    layout = (f"label: dos\nlabel-id: 0x{sig:08x}\nunit: sectors\n\n"
              f"start=2048, size={ESP_MIB}MiB, type=ef, bootable\n"
              f"size={root}MiB, type=83\n"
              f"size={root}MiB, type=83\n"
              f"type=83\n")
    # --wipe: sfdisk borra las firmas viejas del disco y de las particiones (no hay wipefs)
    run(["sfdisk", "--wipe", "always", "--wipe-partitions", "always", path], input=layout)
    subprocess.run(["blockdev", "--rereadpt", path], capture_output=True)
    run(["udevadm", "settle", "-t", "30"])
    for _ in range(20):
        parts = parts_of(path)
        if len(parts) == 4 and all(os.path.exists(p) for p in parts):
            return sig, parts
        time.sleep(0.5)
    raise InstallError("the new partitions did not appear")


def blkid(dev, tag):
    return run(["blkid", "-s", tag, "-o", "value", dev]).strip()


def copy_tree(src, dst, entries, label):
    """cp -a de unas entradas de src a dst, con el porcentaje según lo ocupado."""
    total = sum(du(os.path.join(src, e)) for e in entries) or 1
    base = used(dst)
    proc = subprocess.Popen(["cp", "-a", *[os.path.join(src, e) for e in entries], dst + "/"],
                            stderr=subprocess.PIPE, text=True)
    stop = threading.Event()

    def progress():
        while not stop.wait(2):
            pct = min(99, (used(dst) - base) * 100 // total)
            print(f"\r    {label}: {pct}%", end="", flush=True)

    t = threading.Thread(target=progress, daemon=True)
    t.start()
    err = proc.communicate()[1]
    stop.set()
    t.join()
    print(f"\r    {label}: {'100%' if proc.returncode == 0 else 'failed'}", flush=True)
    if proc.returncode != 0:
        raise InstallError(f"copy failed: {err.strip()[-400:]}")


def du(path):
    p = subprocess.run(["du", "-sxb", path], capture_output=True, text=True)
    try:
        return int(p.stdout.split()[0])
    except (ValueError, IndexError):
        return 0


def used(path):
    st = os.statvfs(path)
    return (st.f_blocks - st.f_bfree) * st.f_frsize


def grubenv(slot):
    """Bloque de entorno de GRUB: exactamente 1024 bytes."""
    head = f"# GRUB Environment Block\nslot={slot}\n"
    return (head + "#" * (1024 - len(head))).encode()


def grub_cfg(sig, uuid_a, uuid_b):
    return f"""# AIOS instalado en disco (lo escribe aios-install). Mantén Shift al arrancar para ver el menú.
# Raíz activa: variable slot de grubenv (a o b). El kernel se lee de /boot/bzImage de esa raíz.
set default="0"
set timeout="0"
set timeout_style="hidden"
terminal_output console
set slot=a
load_env --file $prefix/grubenv slot
if [ "$slot" = "b" ]; then
    set aios_uuid={uuid_b}
    set aios_root=PARTUUID={sig:08x}-03
else
    set aios_uuid={uuid_a}
    set aios_root=PARTUUID={sig:08x}-02
fi
export aios_uuid
export aios_root

menuentry "AIOS" {{
    search --no-floppy --fs-uuid --set=root $aios_uuid
    linux /boot/bzImage root=$aios_root {KERNEL_ARGS} quiet loglevel=3 vt.global_cursor_default=0
}}

menuentry "AIOS (recovery)" {{
    search --no-floppy --fs-uuid --set=root $aios_uuid
    linux /boot/bzImage root=$aios_root {KERNEL_ARGS} loglevel=7 systemd.unit=rescue.target
}}
"""


def install_grub(path, esp, sig, uuid_a, uuid_b):
    core = open(f"{BOOT}/core-pc.img", "rb").read()
    if 512 + len(core) > 2048 * 512:
        raise InstallError("the BIOS GRUB image does not fit before the first partition")
    mbr = open(f"{BOOT}/boot.img", "rb").read()[:440]   # 440..511: firma y tabla, intactas
    with open(path, "r+b") as f:
        f.write(mbr)
        f.seek(512)
        f.write(core)
        f.flush()
        os.fsync(f.fileno())
    os.makedirs(f"{esp}/EFI/BOOT", exist_ok=True)
    os.makedirs(f"{esp}/aios/grub", exist_ok=True)
    shutil.copyfile(f"{BOOT}/bootx64.efi", f"{esp}/EFI/BOOT/BOOTX64.EFI")
    open(f"{esp}/aios/grub/grub.cfg", "w").write(grub_cfg(sig, uuid_a, uuid_b))
    open(f"{esp}/aios/grub/grubenv", "wb").write(grubenv("a"))


def configure_root(root, sig, luks_uuid, disk):
    """La raíz A sabe que está en disco: /home cifrado y los datos de la instalación."""
    open(f"{root}/etc/crypttab", "w").write(
        "# /home cifrado: systemd-cryptsetup pide la frase en la consola al arrancar.\n"
        "# tries=0: la vuelve a pedir si se escribe mal (root está bloqueado:\n"
        "# el modo de emergencia no serviría de nada).\n"
        f"home UUID={luks_uuid} none luks,discard,tries=0\n")
    with open(f"{root}/etc/fstab", "a") as f:
        f.write("/dev/mapper/home /home ext4 defaults 0 2\n")
    with open(f"{root}{INSTALL_INFO}", "w") as f:
        f.write(f"# Escrito por aios-install\nDATE={time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}\n"
                f"DISK_ID=0x{sig:08x}\nSLOT=a\nMODEL={(disk.get('model') or '').strip()}\n")
    # el journal del USB no pertenece a este equipo
    shutil.rmtree(f"{root}/var/log/journal", ignore_errors=True)
    os.makedirs(f"{root}/var/log/journal", exist_ok=True)


def install(disk, passphrase, source="/"):
    path = disk["path"]
    src, mnt = f"{WORK}/src", f"{WORK}/target"
    esp, home = f"{WORK}/esp", f"{WORK}/home"
    for d in (src, mnt, esp, home):
        os.makedirs(d, exist_ok=True)
    mapper = "aios-install-home"
    mounted = []
    try:
        step(f"Erasing {disk['name']} and creating partitions")
        free_disk(disk)
        sig, (p_esp, p_a, p_b, p_home) = partition(path, int(disk["size"]))

        step("Creating file systems")
        run(["mkfs.vfat", "-F", "32", "-n", "AIOS_EFI", p_esp])
        run(["mkfs.ext4", "-q", "-F", "-L", "aios-a", p_a])
        run(["mkfs.ext4", "-q", "-F", "-L", "aios-b", p_b])

        step("Encrypting the partition for your files (LUKS2)")
        run(["cryptsetup", "luksFormat", "--type", "luks2", "--batch-mode", "--label", "aios-home",
             "--key-file", "-", p_home], input=passphrase)
        run(["cryptsetup", "open", "--key-file", "-", p_home, mapper], input=passphrase)
        mounted.append(("crypt", mapper))
        run(["mkfs.ext4", "-q", "-F", "-L", "aios-home", f"/dev/mapper/{mapper}"])

        # Una montura «bind» de / ve la raíz sin lo montado encima (/proc, /run, /tmp...)
        for dev, where, opts in ((p_a, mnt, []), (source, src, ["--bind"]), (p_esp, esp, []),
                                 (f"/dev/mapper/{mapper}", home, [])):
            run(["mount", *opts, dev, where])
            mounted.append(("mount", where))

        step("Copying the system (several minutes)")
        entries = sorted(e for e in os.listdir(src) if e not in ("home", "lost+found"))
        copy_tree(src, mnt, entries, "system")
        os.makedirs(f"{mnt}/home", exist_ok=True)
        os.chmod(f"{mnt}/home", 0o755)
        step("Copying your files")
        homes = sorted(os.listdir(f"{src}/home"))
        if homes:
            copy_tree(f"{src}/home", home, homes, "home")

        step("Setting up the boot loader (BIOS and UEFI)")
        uuid_a, uuid_b = blkid(p_a, "UUID"), blkid(p_b, "UUID")
        configure_root(mnt, sig, blkid(p_home, "UUID"), disk)
        install_grub(path, esp, sig, uuid_a, uuid_b)
        run(["sync"])
    finally:
        for kind, what in reversed(mounted):
            if kind == "mount":
                subprocess.run(["umount", what], capture_output=True)
            else:
                subprocess.run(["cryptsetup", "close", what], capture_output=True)


# --- conversación -----------------------------------------------------------------------

def ask(prompt):
    try:
        return input(prompt).strip()
    except EOFError:
        return ""


def choose_disk(candidates):
    usable = [d for d in candidates if not d["unusable"]]
    print("Disks in this computer:")
    for d in candidates:
        print(f"  {describe(d)}" + (f"   [{d['unusable']}]" if d["unusable"] else ""))
    if not usable:
        return None
    if len(usable) == 1:
        return usable[0]
    names = [d["name"] for d in usable]
    while True:
        ans = ask(f"Disk to install on ({', '.join(names)}; Enter to cancel): ")
        if not ans:
            return None
        for d in usable:
            if ans in (d["name"], d["path"]):
                return d


def ask_passphrase():
    print("\nYour files (/home) will be encrypted. Choose a passphrase: it will be asked")
    print("every time the computer starts. If you forget it, your files cannot be recovered.")
    for _ in range(3):
        p1 = getpass.getpass("Passphrase: ")
        if not p1:
            return None
        if len(p1) < MIN_PASSPHRASE:
            print(f"At least {MIN_PASSPHRASE} characters.")
            continue
        if getpass.getpass("Repeat it: ") == p1:
            return p1
        print("They do not match.")
    return None


def main():
    p = argparse.ArgumentParser(prog="aios-install", description="Install AIOS on a disk (erases the whole disk)")
    p.add_argument("--list", action="store_true", help="list the disks and whether AIOS can be installed on them")
    p.add_argument("--json", action="store_true", help="with --list: machine-readable output")
    p.add_argument("--disk", help="disk to install on, e.g. /dev/sda")
    p.add_argument("--confirm", metavar="NAME", help="the disk name again (e.g. sda): confirms erasing it")
    p.add_argument("--passphrase-file", help="file with the passphrase for /home (otherwise it is asked)")
    args = p.parse_args()

    if args.list:
        ds = disks()
        if args.json:
            print(json.dumps([{"name": d["name"], "size": int(d["size"]), "model": (d.get("model") or "").strip(),
                               "transport": d.get("tran"), "usable": not d["unusable"],
                               "reason": d["unusable"]} for d in ds]))
        else:
            for d in ds:
                print(describe(d) + (f"   [{d['unusable']}]" if d["unusable"] else ""))
        return 0
    if os.geteuid() != 0:
        print("Run it as administrator: sudo aios-install", file=sys.stderr)
        return 1
    if os.path.exists(INSTALL_INFO):
        print("This AIOS is already installed on a disk. To install again, start the computer "
              "from the AIOS USB and run aios-install there.", file=sys.stderr)
        return 1
    for tool in ("sfdisk", "mkfs.vfat", "mkfs.ext4", "cryptsetup", "blkid", "lsblk", "udevadm"):
        if not shutil.which(tool):
            print(f"Missing {tool}: this AIOS image cannot install to disk.", file=sys.stderr)
            return 1
    for f in ("boot.img", "core-pc.img", "bootx64.efi"):
        if not os.path.exists(f"{BOOT}/{f}"):
            print(f"Missing {BOOT}/{f}: this AIOS image cannot install to disk.", file=sys.stderr)
            return 1

    candidates = disks()
    if args.disk:
        disk = next((d for d in candidates if args.disk in (d["name"], d["path"])), None)
        if not disk:
            print(f"No such disk: {args.disk}", file=sys.stderr)
            return 1
        if disk["unusable"]:
            print(f"Cannot install on {disk['name']}: {disk['unusable']}", file=sys.stderr)
            return 1
    else:
        print("AIOS installer. It ERASES the whole disk you choose.\n")
        disk = choose_disk(candidates)
        if not disk:
            print("No disk chosen: nothing was changed.")
            return 1

    slot = slot_size(int(disk["size"]))
    print(f"\nTarget: {describe(disk)}")
    print("  Everything on it will be ERASED:")
    print("\n".join(contents(disk)))
    print(f"  New layout: boot {ESP_MIB} MB, system A {slot // GiB} GiB, system B {slot // GiB} GiB "
          f"(for updates), your files (encrypted) {human(int(disk['size']) - 2 * slot - ESP_MIB * 2 ** 20)}")
    print("  The system and your files on this USB are copied as they are "
          "(password, language, wifi, chats).")

    confirm = args.confirm
    if confirm is None:
        confirm = ask(f"\nType the disk name ({disk['name']}) to erase it and install AIOS: ")
    if confirm != disk["name"]:
        print("Not confirmed: nothing was changed.")
        return 1

    if args.passphrase_file:
        passphrase = open(args.passphrase_file).read().rstrip("\n")
        if len(passphrase) < MIN_PASSPHRASE:
            print(f"The passphrase needs at least {MIN_PASSPHRASE} characters.", file=sys.stderr)
            return 1
    else:
        passphrase = ask_passphrase()
        if not passphrase:
            print("No passphrase: nothing was changed.")
            return 1

    print(f"\nInstalling AIOS on {disk['name']}...")
    t0 = time.time()
    try:
        install(disk, passphrase)
    except InstallError as e:
        print(f"\nThe installation FAILED: {e}", file=sys.stderr)
        print("The disk is left unusable; you can run aios-install again.", file=sys.stderr)
        return 1
    print(f"\nAIOS is installed on {disk['name']} ({(time.time() - t0) / 60:.0f} min).")
    print("Turn the computer off, remove the USB and turn it on: it will ask for the passphrase.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nCancelled.")
        sys.exit(130)
