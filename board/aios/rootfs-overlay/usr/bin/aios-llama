#!/bin/sh
# AIOS — arranca llama-server con /etc/aios/llama.conf (lo llama aios-llama.service).
set -e
CONF=/etc/aios/llama.conf
MODELS=/usr/share/aios/models
[ -f "$CONF" ] && . "$CONF"

pick() { # pick <patrón find> <excluir mmproj: yes/no>
    if [ "$2" = yes ]; then
        find "$MODELS" -maxdepth 1 -name "$1" ! -name '*mmproj*' | sort | head -n1
    else
        find "$MODELS" -maxdepth 1 -name "$1" | sort | head -n1
    fi
}

if [ -n "$MODEL" ] && [ -f "$MODELS/$MODEL" ]; then
    model="$MODELS/$MODEL"
else
    [ -n "$MODEL" ] && echo "aios-llama: $MODELS/$MODEL not found, autodetecting" >&2
    model=$(pick '*.gguf' yes)
fi
if [ -z "$model" ]; then
    echo "aios-llama: no model in $MODELS (build with 'make model' first)" >&2
    exit 1
fi

if [ -n "$MMPROJ" ] && [ -f "$MODELS/$MMPROJ" ]; then
    mmproj="$MODELS/$MMPROJ"
else
    mmproj=$(pick '*mmproj*.gguf' no)
fi

# Contexto: "auto" = lo que cabe en la RAM de este equipo, con tope por
# velocidad (16K en 8 GB, 32K con 12 GB o más); ver /usr/lib/aios/aios/gguf.py
ctx=${CTX:-auto}
if [ "$ctx" = auto ]; then
    ctx=$(python3 -I /usr/lib/aios/aios/gguf.py auto "$model" "$mmproj") || ctx=16384
fi

threads=${THREADS:-auto}
if [ "$threads" = auto ]; then
    threads=$(lscpu -p=Core,Socket 2>/dev/null | grep -v '^#' | sort -u | wc -l)
    [ "$threads" -gt 0 ] 2>/dev/null || threads=$(nproc)
fi

set -- -m "$model" \
    --host "${HOST:-127.0.0.1}" --port "${PORT:-8083}" \
    -c "$ctx" -t "$threads" -np 1 --jinja
[ -n "$mmproj" ] && set -- "$@" --mmproj "$mmproj"

echo "aios-llama: $(basename "$model")${mmproj:+ + $(basename "$mmproj")}, ctx $ctx, $threads threads"
# shellcheck disable=SC2086  # EXTRA_ARGS se parte en palabras a propósito
exec /usr/bin/llama-server "$@" $EXTRA_ARGS
