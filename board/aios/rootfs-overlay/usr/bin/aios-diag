#!/bin/sh
# AIOS — recoge logs y datos del equipo en un .tar.gz y lo sube al receptor
# de diagnósticos (/etc/aios/diag.conf). Funciona desde la shell de tty1
# aunque sway no haya arrancado.
#   aios-diag           recoge y sube
#   aios-diag --local   solo recoge (deja el .tar.gz en /tmp)
CONF=/etc/aios/diag.conf
TOKEN_FILE=/etc/aios/diag.token
[ -f "$CONF" ] && . "$CONF"

upload=yes
case "$1" in
    --local) upload=no ;;
    "") ;;
    *) echo "usage: aios-diag [--local]" >&2; exit 2 ;;
esac

host=$(hostname 2>/dev/null || echo aios)
name="aios-diag-$host-$(date +%Y%m%d-%H%M%S)"
work=$(mktemp -d) || exit 1
dir="$work/$name"
mkdir -p "$dir"
trap 'rm -rf "$work"' EXIT

# run <fichero> <orden...>: guarda salida y errores; nada puede colgar la
# recogida (límite RUN_TIMEOUT segundos, 20 por defecto)
run() {
    out="$dir/$1"; shift
    { echo "\$ $*"; timeout "${RUN_TIMEOUT:-20}" "$@" 2>&1; echo "[exit $?]"; } > "$out"
}
copy() { # copy <origen> <destino en el paquete>
    [ -r "$1" ] && cp "$1" "$dir/$2" 2>/dev/null
}

echo "AIOS diag: collecting..."

# --- Sistema y hardware ------------------------------------------------------
run system.txt sh -c 'cat /etc/os-release; echo; uname -a; echo; uptime; echo;
    cat /proc/cmdline; echo; [ -d /sys/firmware/efi ] && echo "boot: UEFI" || echo "boot: BIOS"'
run cpu.txt lscpu
run memory.txt sh -c 'free -h; echo; cat /proc/meminfo'
run disks.txt sh -c 'lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS; echo; df -h'
run pci.txt lspci -nnk
run usb.txt lsusb
run modules.txt lsmod
run dmi.txt sh -c 'cd /sys/class/dmi/id 2>/dev/null &&
    for f in sys_vendor product_name product_version board_name bios_vendor bios_version bios_date; do
        printf "%s: %s\n" "$f" "$(cat $f 2>/dev/null)"; done'

# --- Gráficos ----------------------------------------------------------------
run graphics.txt sh -c 'ls -l /dev/dri; echo;
    for c in /sys/class/drm/card* /sys/class/drm/renderD*; do
        [ -e "$c/device/driver" ] || continue
        printf "%s: driver=%s" "${c##*/}" "$(basename "$(readlink "$c/device/driver")")"
        [ -r "$c/status" ] && printf " status=%s" "$(cat "$c/status")"
        echo
    done; echo; env | grep -E "^(WLR_|XDG_|WAYLAND_)" | sort'
run gpu-probe.txt sh -c 'EGL_LOG_LEVEL=debug aios-gpu-probe'
for f in "$HOME"/.local/state/aios/*.log "$HOME"/.local/state/aios/*.log.old; do
    [ -f "$f" ] && cp "$f" "$dir/" 2>/dev/null
done

# --- systemd y journal (aios está en systemd-journal: ve el del sistema) ------
run journal-boot.txt journalctl -b --no-pager -o short-monotonic
run journal-prev-boot.txt journalctl -b -1 --no-pager -o short-monotonic -n 3000
run journal-errors.txt journalctl -b --no-pager -p warning
run systemd-failed.txt systemctl --failed --no-pager
run llama.txt sh -c 'systemctl status aios-llama --no-pager; echo;
    journalctl -b -u aios-llama --no-pager -n 300; echo;
    curl -s -m 5 http://127.0.0.1:8083/health; echo'
copy /etc/aios/llama.conf llama.conf

# Velocidad del modelo en este equipo: una respuesta corta; "timings" trae
# tokens/s de lectura del prompt (prompt_per_second) y de generación
# (predicted_per_second). Se salta si llama-server no está listo.
if curl -s -m 5 http://127.0.0.1:8083/health 2>/dev/null | grep -q '"ok"'; then
    echo "AIOS diag: measuring model speed (up to 3 min)..."
    RUN_TIMEOUT=200
    run bench.txt curl -s -m 180 http://127.0.0.1:8083/completion \
        -H "Content-Type: application/json" \
        -d "{\"prompt\": \"Explain in three sentences what an operating system does.\", \"n_predict\": ${BENCH_TOKENS:-64}, \"cache_prompt\": false}"
    RUN_TIMEOUT=20
    speed=$(grep -o '"predicted_per_second":[0-9.]*' "$dir/bench.txt" | cut -d: -f2 | cut -c1-5)
    [ -n "$speed" ] && echo "AIOS diag: model speed: $speed tokens/s"
fi
run models.txt ls -l /usr/share/aios/models

# --- Red (sin secretos: /var/lib/iwd guarda las claves wifi y no se toca) ----
run network.txt sh -c 'ip addr; echo; ip route; echo; networkctl status --no-pager; echo;
    cat /etc/resolv.conf; echo; iwctl station list 2>/dev/null'

# --- Empaquetar --------------------------------------------------------------
tarball="/tmp/$name.tar.gz"
# El tar de la imagen es el de BusyBox, sin -z: se comprime aparte.
tar -cf - -C "$work" "$name" | gzip > "$tarball" || { echo "AIOS diag: tar failed" >&2; exit 1; }
size=$(du -h "$tarball" | cut -f1)
echo "AIOS diag: saved $tarball ($size)"
[ "$upload" = yes ] || exit 0

if [ -z "$URL" ] || [ ! -r "$TOKEN_FILE" ]; then
    echo "AIOS diag: no upload configured ($CONF, $TOKEN_FILE). Copy the file by hand." >&2
    exit 1
fi
echo "AIOS diag: uploading to $URL ..."
resp=$(curl -sS -m 120 --fail-with-body \
    -H "Authorization: Bearer $(cat "$TOKEN_FILE")" \
    -H "X-AIOS-Host: $host" \
    -H "Content-Type: application/gzip" \
    --data-binary "@$tarball" "$URL" 2>&1)
rc=$?
if [ $rc -eq 0 ]; then
    echo "AIOS diag: uploaded as $resp"
else
    echo "AIOS diag: upload failed: $resp" >&2
    echo "AIOS diag: check the network ('ip addr', 'iwctl') and retry, or copy $tarball by hand." >&2
    exit 1
fi
