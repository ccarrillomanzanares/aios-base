#!/usr/bin/env python3
"""AIOS — consola del agente (hito 0, con el agente v0 del hito 1).

Habla con el proveedor activo (el modelo local o uno externo) y puede usar dos
herramientas: 'aios' (la CLI del sistema, con su contrato JSON) y 'look'
(mirar la pantalla). Lo que cambia el sistema pide confirmación; las
consultas no. Voz: Super+Espacio (aios-voice) o /voice; las respuestas a
la voz se leen en voz alta. Las conversaciones se guardan y /resume las
retoma. Solo biblioteca estándar: la imagen no lleva requests.
"""
import json
import os
import random
import readline  # noqa: F401  (historial y edición de línea en input())
import shlex
import signal
import subprocess
import sys
import termios
import time
import urllib.error
import urllib.request

sys.path.insert(0, os.environ.get("AIOS_LIB", "/usr/lib/aios"))
from aios import ai as aiconf  # noqa: E402  (proveedor activo: local o externo)
from aios import cli as aios_cli  # noqa: E402  (validar órdenes antes de ejecutarlas)
from aios import look as looker  # noqa: E402
from aios import voice  # noqa: E402

PORT = os.environ.get("AIOS_LLAMA_PORT", "8083")
BASE = f"http://127.0.0.1:{PORT}"
MAX_REPLY = 2048     # tokens de respuesta como máximo
HISTORY_SHARE = 0.75  # la conversación cabe en el 75 % del contexto
MAX_STEPS = 6        # llamadas a herramientas seguidas en un turno
TOOL_OUTPUT = 2000   # caracteres de salida de herramienta que ve el modelo
CHATS = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"),
                     "aios", "chats")
SYSTEM = (
    "You are AIOS, the assistant built into this operating system. "
    "Answer briefly and in the user's language. "
    "For anything about this computer (network and wifi, sound, screen brightness, "
    "AI settings, updates) use the aios tool and base your answer on its JSON result; "
    "never invent results. If a result has a hint, follow it or tell the user. "
    "Use the look tool when the user asks about what is on the screen."
)
TOOLS = [
    {"type": "function", "function": {
        "name": "aios",
        "description": (
            "Run an AIOS system command and get its JSON result. Use ONLY these commands:\n"
            "- net status: network and Internet state\n"
            "- net wifi scan | net wifi connect <ssid> --password <p> | net wifi disconnect\n"
            "- audio status: volume and devices | audio volume <0-100|up|down> | "
            "audio mute <on|off> | audio test\n"
            "- ui brightness: read the screen brightness | ui brightness <5-100|up|down>: set it\n"
            "- ui display list | ui display extend | ui display mirror\n"
            "- bt status | bt scan | bt connect <name>\n"
            "- sys selftest: test the hardware\n"
            "- ai status | update code check"),
        "parameters": {"type": "object", "properties": {
            "command": {"type": "string", "description": "e.g. 'net wifi scan'"}},
            "required": ["command"]}}},
    {"type": "function", "function": {
        "name": "look",
        "description": "Look at the user's screen and answer a question about it.",
        "parameters": {"type": "object", "properties": {
            "question": {"type": "string"}}, "required": ["question"]}}},
]
# Consultas que el agente puede hacer sin preguntar (no cambian nada)
READ_ONLY = [("net", "status"), ("net", "wifi", "scan"), ("audio", "status"),
             ("ai", "status"), ("ai", "list"), ("update", "code", "check"),
             ("ui", "display", "list"), ("bt", "status"), ("bt", "scan"), ("sys", "selftest")]
VALID_HINT = ("Valid commands: net status, net wifi scan, net wifi connect <ssid> --password <p>, "
              "audio status, audio volume <n>, ui brightness [n], ui display list, bt status, "
              "sys selftest, ai status, update code check")

# Frases de películas, como en aios-agent (chat.py)
QUOTES = [
    "Greetings, Professor Falken.",
    "Shall we play a game?",
    "Would you prefer a nice game of chess?",
    "A strange game. The only winning move is not to play.",
    "Wake up, Neo... The Matrix has you...",
    "Follow the white rabbit.",
    "Greetings, Programs!",
    "End of line.",
    "Open the pod bay doors, HAL.",
    "I'll be back.",
]

TYPE_DELAY = 0.025
DIM, RESET = "\033[2m", "\033[0m"


def typewriter(text, delay=TYPE_DELAY, end="\n"):
    """Escribe carácter a carácter, como el terminal de WOPR."""
    for ch in text:
        sys.stdout.write(ch)
        sys.stdout.flush()
        if ch != " ":
            time.sleep(delay)
    sys.stdout.write(end)
    sys.stdout.flush()


class NoEcho:
    """Sin eco mientras sale la intro y carga el modelo: lo tecleado antes de
    tiempo no se pinta sobre el giro; readline lo recoge luego en el prompt."""

    def __enter__(self):
        try:
            self.saved = termios.tcgetattr(sys.stdin)
            attrs = termios.tcgetattr(sys.stdin)
            attrs[3] &= ~termios.ECHO
            termios.tcsetattr(sys.stdin, termios.TCSANOW, attrs)
        except (termios.error, ValueError, OSError):
            self.saved = None
        return self

    def __exit__(self, *exc):
        if self.saved is not None:
            termios.tcsetattr(sys.stdin, termios.TCSANOW, self.saved)


def server_ready():
    try:
        with urllib.request.urlopen(BASE + "/health", timeout=2) as r:
            return r.status == 200
    except (urllib.error.URLError, OSError):
        return False


def wait_for_server():
    """Espera a que llama-server termine de cargar el modelo."""
    if server_ready():
        return True
    sys.stdout.write("LOADING MODEL  ")  # el giro reescribe el último carácter
    sys.stdout.flush()
    spin = "|/-\\"
    for i in range(600):  # 5 minutos
        if server_ready():
            sys.stdout.write("\rLOADING MODEL ... OK\n")
            return True
        sys.stdout.write("\b" + spin[i % 4])
        sys.stdout.flush()
        time.sleep(0.5)
    sys.stdout.write("\rLOADING MODEL ... FAILED\n")
    print("The local model is not responding. Check: journalctl -u aios-llama")
    return False


# --- Contexto --------------------------------------------------------------------

def msg_chars(m):
    return len(m.get("content") or "") + len(json.dumps(m.get("tool_calls") or ""))


class Context:
    """Presupuesto de contexto: sin recorte, al llenarse el contexto el
    servidor rechaza la petición y el chat solo daría ERROR hasta /clear.
    El tamaño es el del proveedor (el local lo dice su /props)."""

    def __init__(self, provider):
        self.n_ctx = aiconf.context_of(provider)
        self.chars_per_token = 3.0  # se ajusta con lo que mide el servidor
        self.tools_tokens = len(json.dumps(TOOLS)) // 3

    def reply_tokens(self):
        return min(MAX_REPLY, self.n_ctx // 4)  # en contextos pequeños, menos reserva

    def budget(self):
        return min(int(self.n_ctx * HISTORY_SHARE), self.n_ctx - self.reply_tokens()) - self.tools_tokens

    def estimate(self, messages):
        chars = sum(msg_chars(m) for m in messages)
        return int(chars / self.chars_per_token) + 8 * len(messages)

    def calibrate(self, messages, prompt_tokens):
        chars = sum(msg_chars(m) for m in messages) + len(json.dumps(TOOLS))
        if prompt_tokens and chars > 200:
            self.chars_per_token = max(1.5, min(6.0, chars / prompt_tokens))

    def trim(self, messages, force=False):
        """Quita los turnos más antiguos enteros (pregunta, llamadas a
        herramientas y respuesta), nunca el sistema ni el turno en curso."""
        dropped = 0
        while force or self.estimate(messages) > self.budget():
            users = [i for i, m in enumerate(messages) if m["role"] == "user"]
            if len(users) < 2:
                break
            del messages[users[0]:users[1]]
            dropped += 1
            force = False
        return dropped


# --- Modelo -------------------------------------------------------------------------

class Session:
    def __init__(self, provider):
        self.provider = provider
        self.ctx = Context(provider)
        self.tools = True       # se apaga si el proveedor no admite herramientas
        self.speak_always = False


def request(messages, sess, stream=True):
    body = {"messages": messages, "stream": stream, "max_tokens": sess.ctx.reply_tokens()}
    if stream:
        body["stream_options"] = {"include_usage": True}
    if sess.tools:
        body["tools"] = TOOLS
    p = sess.provider
    if p["local"]:
        # Sin razonamiento en el hito 0: en CPU cada token cuenta. Solo al
        # local: una API estricta rechaza parámetros que no conoce.
        body["chat_template_kwargs"] = {"enable_thinking": False}
    elif p.get("model"):
        body["model"] = p["model"]
    req = urllib.request.Request(p["url"].rstrip("/") + "/chat/completions",
                                 data=json.dumps(body).encode(), headers=aiconf.headers(p))
    return urllib.request.urlopen(req, timeout=600, context=aiconf.ssl_context(p))


def complete(messages, sess):
    """Una respuesta del modelo, escrita según llega. (texto, llamadas)."""
    reply, calls = [], {}
    t0, ntok = time.monotonic(), 0
    usage = timings = None
    with request(messages, sess) as r:
        for raw in r:
            line = raw.decode("utf-8", "replace").strip()
            if not line.startswith("data:"):
                continue
            data = line[5:].strip()
            if data == "[DONE]":
                break
            chunk = json.loads(data)
            usage = chunk.get("usage") or usage
            timings = chunk.get("timings") or timings
            delta = (chunk.get("choices") or [{}])[0].get("delta") or {}
            piece = delta.get("content") or ""
            if piece:
                ntok += 1
                reply.append(piece)
                sys.stdout.write(piece)
                sys.stdout.flush()
            for tc in delta.get("tool_calls") or []:  # llegan a trozos
                c = calls.setdefault(tc.get("index", 0), {"id": "", "name": "", "arguments": ""})
                c["id"] = tc.get("id") or c["id"]
                fn = tc.get("function") or {}
                c["name"] += fn.get("name") or ""
                c["arguments"] += fn.get("arguments") or ""
    dt = time.monotonic() - t0
    if reply:
        sys.stdout.write("\n")
    if usage:
        sess.ctx.calibrate(messages, usage.get("prompt_tokens"))
    if not calls:
        # Velocidad medida por el servidor; si no la da, la del reloj
        if timings and timings.get("predicted_n"):
            print(f"{DIM}[{timings['predicted_n']} tokens, "
                  f"{timings.get('predicted_per_second', 0):.1f} tok/s]{RESET}")
        elif ntok and dt > 0:
            print(f"{DIM}[{ntok} tokens, {ntok / dt:.1f} tok/s]{RESET}")
    return "".join(reply), [calls[i] for i in sorted(calls)]


def http_error_body(err):
    try:
        return err.read().decode("utf-8", "replace").lower()
    except OSError:
        return ""


# --- Herramientas ---------------------------------------------------------------------

def ask_yes(question):
    try:
        return input(f"{question} [y/N] ").strip().lower() in ("y", "yes", "s", "si", "sí")
    except (EOFError, KeyboardInterrupt):
        print()
        return False


def is_read_only(args):
    words = [a for a in args if not a.startswith("-")]
    if any(tuple(words[:len(r)]) == r for r in READ_ONLY):
        return True
    # Sin valor, volumen y brillo solo consultan
    return words[:2] in (["audio", "volume"], ["ui", "brightness"]) and len(words) == 2


def run_aios(command):
    try:
        args = shlex.split(command)
    except ValueError as e:
        return {"ok": False, "code": "BAD_COMMAND", "data": {"error": str(e)}}
    if args and args[0] == "aios":
        args = args[1:]
    args = [a for a in args if a != "--json"]
    shown = " ".join(shlex.quote(a) if not prev_is_password(args, i) else "******"
                     for i, a in enumerate(args))
    print(f"{DIM}[aios {shown}]{RESET}")
    err = aios_cli.validate(args)
    if err:  # orden inexistente o mal escrita: al modelo, sin molestar al usuario
        print(f"{DIM}[not a valid command]{RESET}")
        return {"ok": False, "code": "USAGE", "data": {"error": err}, "hint": VALID_HINT}
    if not is_read_only(args) and not ask_yes(f"Run 'aios {shown}'?"):
        return {"ok": False, "code": "USER_DECLINED", "data": {},
                "hint": "The user did not allow this command."}
    for _ in range(2):
        p = subprocess.run(["aios", *args, "--json"], capture_output=True, text=True,
                           timeout=180, stdin=subprocess.DEVNULL)
        try:
            res = json.loads(p.stdout.strip().splitlines()[-1])
        except (ValueError, IndexError):
            return {"ok": False, "code": "BAD_OUTPUT", "data": {"output": (p.stdout + p.stderr)[-500:]}}
        # El contrato pide un token para lo delicado: el sí ya lo dio el usuario
        # (o se le pregunta ahora, con lo que el comando explica)
        if res.get("code") == "CONFIRM_REQUIRED" and res.get("confirm"):
            text = res.get("hint") or ""
            if not ask_yes(f"{text}\nConfirm?"):
                return {"ok": False, "code": "USER_DECLINED", "data": {}}
            args = args + ["--confirm", res["confirm"]]
            continue
        return res
    return res


def prev_is_password(args, i):
    return i > 0 and args[i - 1] in ("--password", "--api-key")


def run_look(question, sess):
    print(f"{DIM}[look: {question}]{RESET}")
    try:
        answer = looker.describe(question, looker.capture(), sess.provider)
        return {"ok": True, "data": {"answer": answer}}
    except urllib.error.HTTPError as e:
        return {"ok": False, "code": "LOOK_MODEL_FAILED", "data": {"error": f"HTTP {e.code}"}}
    except (OSError, RuntimeError, ValueError, KeyError, subprocess.TimeoutExpired) as e:
        return {"ok": False, "code": "LOOK_NO_SCREEN", "data": {"error": str(e)}}


def run_tool(call, sess):
    try:
        args = json.loads(call["arguments"] or "{}")
    except ValueError:
        args = {}
    if call["name"] == "aios":
        res = run_aios(str(args.get("command", "")))
    elif call["name"] == "look":
        res = run_look(str(args.get("question") or "Describe the screen."), sess)
    else:
        res = {"ok": False, "code": "UNKNOWN_TOOL", "data": {"name": call["name"]}}
    return json.dumps(res, ensure_ascii=False)[:TOOL_OUTPUT]


# --- Un turno ------------------------------------------------------------------------

def turn(messages, sess, text, spoken_lang=None):
    """Pregunta del usuario -> respuesta, con las herramientas que hagan falta."""
    messages.append({"role": "user", "content": text})
    start = len(messages) - 1
    if sess.ctx.trim(messages):
        print(f"{DIM}[older messages forgotten to make room]{RESET}")
    answer = ""
    for _ in range(MAX_STEPS):
        try:
            content, calls = complete(messages, sess)
        except KeyboardInterrupt:
            print("\n[interrupted]")
            del messages[start:]
            return
        except urllib.error.HTTPError as e:
            body = http_error_body(e)
            if e.code == 400 and sess.tools and "tool" in body:
                sess.tools = False  # proveedor sin herramientas: se sigue sin ellas
                print(f"{DIM}[this provider does not support tools]{RESET}")
                continue
            if e.code == 400 and ("context" in body or "exceed" in body) and sess.ctx.trim(messages, force=True):
                print(f"{DIM}[older messages forgotten to make room]{RESET}")
                continue
            print(f"\nERROR: {e}")
            del messages[start:]
            return
        except (urllib.error.URLError, OSError, ValueError) as e:
            print(f"\nERROR: {e}")
            del messages[start:]
            return
        msg = {"role": "assistant", "content": content}
        if calls:
            msg["tool_calls"] = [{"id": c["id"] or f"call{i}", "type": "function",
                                  "function": {"name": c["name"], "arguments": c["arguments"]}}
                                 for i, c in enumerate(calls)]
        messages.append(msg)
        answer = content
        if not calls:
            break
        for c, tc in zip(calls, msg["tool_calls"]):
            messages.append({"role": "tool", "tool_call_id": tc["id"], "content": run_tool(c, sess)})
    if answer and (spoken_lang or sess.speak_always):
        voice.speak(answer, spoken_lang)
    save(messages)


# --- Historial -------------------------------------------------------------------------

SESSION_FILE = None


def save(messages):
    global SESSION_FILE
    if len(messages) < 2:
        return
    os.makedirs(CHATS, exist_ok=True)
    SESSION_FILE = SESSION_FILE or os.path.join(CHATS, time.strftime("%Y%m%d-%H%M%S") + ".json")
    tmp = SESSION_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(messages[1:], f, ensure_ascii=False)
    os.replace(tmp, SESSION_FILE)


def saved_chats():
    try:
        return sorted((f for f in os.listdir(CHATS) if f.endswith(".json")), reverse=True)
    except OSError:
        return []


def first_question(name):
    try:
        with open(os.path.join(CHATS, name)) as f:
            msgs = json.load(f)
        q = next((m["content"] for m in msgs if m["role"] == "user"), "")
        return q.replace("\n", " ")[:60]
    except (OSError, ValueError):
        return "?"


def history():
    chats = saved_chats()[:10]
    if not chats:
        print("No saved conversations.")
    for i, name in enumerate(chats, 1):
        stamp = f"{name[6:8]}/{name[4:6]} {name[9:11]}:{name[11:13]}"
        print(f"{i:>2}  {stamp}  {first_question(name)}")
    if chats:
        print("Continue one with /resume <number> (default: the last one).")


def resume(arg, messages):
    global SESSION_FILE
    chats = saved_chats()
    try:
        name = chats[int(arg or 1) - 1]
        with open(os.path.join(CHATS, name)) as f:
            old = json.load(f)
    except (IndexError, ValueError, OSError):
        print("No such conversation. See /history.")
        return messages
    SESSION_FILE = os.path.join(CHATS, name)
    print(f"Resumed: {first_question(name)} ({sum(1 for m in old if m['role'] == 'user')} questions)")
    return messages[:1] + old


# --- Voz -------------------------------------------------------------------------------

class VoiceInput(Exception):
    """Ha llegado un mensaje hablado (Super+Espacio) mientras se esperaba texto."""


WAITING_INPUT = False


def on_voice(signum, frame):
    if WAITING_INPUT:
        raise VoiceInput


def read_inbox():
    try:
        with open(voice.paths()["inbox"]) as f:
            data = json.load(f)
        os.unlink(voice.paths()["inbox"])
        return data.get("text", "").strip(), data.get("lang")
    except (OSError, ValueError):
        return "", None


def record_until_enter():
    if not voice.start():
        print("Already recording.")
        return "", None
    try:
        input(f"{DIM}[recording... press Enter to stop]{RESET} ")
    except (EOFError, KeyboardInterrupt):
        print()
    wav = voice.stop()
    if not wav:
        print("Too short, nothing recorded.")
        return "", None
    print(f"{DIM}[transcribing...]{RESET}")
    try:
        return voice.transcribe(wav)
    except (RuntimeError, OSError) as e:
        print(f"Voice error: {e}")
        return "", None


# --- Principal -------------------------------------------------------------------------

HELP = ("Type a message. /voice to speak (or hold Super+Space), /look [question] to show "
        "the screen,\n/speak on|off, /history, /resume [n], /clear starts over, /exit quits.")


def main():
    global WAITING_INPUT
    os.system("clear")
    with NoEcho():
        typewriter("AIOS LOCAL TERMINAL")
        typewriter("LOGON: aios")
        print()
        typewriter(random.choice(QUOTES).upper(), delay=0.05)
        print()
        provider = aiconf.provider()
        if not provider["local"]:
            ok, err = aiconf.reachable(provider)
            if ok:
                print(f'REMOTE AI: {provider["name"]} ({provider["url"]})')
            else:
                print(f'REMOTE AI {provider["name"]} NOT REACHABLE ({err}). USING LOCAL MODEL.')
                provider = aiconf.provider("local")
        ready = provider["local"] is False or wait_for_server()
    if not ready:
        return 1
    print(HELP + "\n")
    if saved_chats():
        print(f"{DIM}Last conversation: {first_question(saved_chats()[0])} (/resume){RESET}\n")

    # aios-voice entrega aquí lo dictado con Super+Espacio
    pidfile = voice.paths()["chat"]
    try:
        with open(pidfile, "w") as f:
            f.write(str(os.getpid()))
    except OSError:
        pass
    signal.signal(signal.SIGUSR1, on_voice)

    messages = [{"role": "system", "content": SYSTEM}]
    sess = Session(provider)
    while True:
        lang = None
        try:
            if os.path.exists(voice.paths()["inbox"]):
                raise VoiceInput  # dictado mientras el chat estaba ocupado
            WAITING_INPUT = True
            text = input("> ").strip()
        except VoiceInput:
            text, lang = read_inbox()
            if not text:
                print()
                continue
            print(f"\n{DIM}[voice]{RESET} {text}")
        except (EOFError, KeyboardInterrupt):
            print()
            break
        finally:
            WAITING_INPUT = False
        if not text:
            continue
        if text in ("/exit", "/quit"):
            break
        if text == "/clear":
            messages = messages[:1]
            globals()["SESSION_FILE"] = None
            print("Conversation cleared.")
            continue
        if text in ("/help", "/?"):
            print(HELP)
            continue
        if text == "/history":
            history()
            continue
        if text.startswith("/resume"):
            messages = resume(text[7:].strip(), messages)
            continue
        if text.startswith("/speak"):
            sess.speak_always = text[6:].strip() != "off"
            print(f"Spoken replies {'on' if sess.speak_always else 'off'}.")
            continue
        if text == "/voice":
            text, lang = record_until_enter()
            if not text:
                continue
            print(f"{DIM}[voice]{RESET} {text}")
        if text.startswith("/look"):
            question = text[5:].strip() or "Describe what is on the screen."
            res = run_look(question, sess)
            if res.get("ok"):
                answer = res["data"]["answer"]
                print(answer)
                messages += [{"role": "user", "content": f"(I showed you my screen) {question}"},
                             {"role": "assistant", "content": answer}]
                if sess.speak_always:
                    voice.speak(answer)
                save(messages)
            else:
                print(f"Could not look at the screen: {res.get('data', {}).get('error')}")
            continue
        turn(messages, sess, text, spoken_lang=lang)
    try:
        os.unlink(pidfile)
    except OSError:
        pass
    typewriter("END OF LINE.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
