#!/usr/bin/env python3
"""AIOS — chat mínimo contra llama-server (hito 0).

Solo biblioteca estándar: la imagen no lleva requests. El agente con
herramientas llega en el hito 1; esto comprueba que el modelo responde.
"""
import json
import os
import random
import readline  # noqa: F401  (historial y edición de línea en input())
import sys
import termios
import time
import urllib.error
import urllib.request

sys.path.insert(0, os.environ.get("AIOS_LIB", "/usr/lib/aios"))
from aios import ai as aiconf  # noqa: E402  (proveedor activo: local o externo)

PORT = os.environ.get("AIOS_LLAMA_PORT", "8083")
BASE = f"http://127.0.0.1:{PORT}"
MAX_REPLY = 2048     # tokens de respuesta como máximo
HISTORY_SHARE = 0.75  # la conversación cabe en el 75 % del contexto
SYSTEM = (
    "You are AIOS, the assistant built into this operating system. "
    "Answer briefly and in the user's language."
)

# Frases de películas, como en aios-agent (chat.py)
QUOTES = [
    "Greetings, Professor Falken.",
    "Shall we play a game?",
    "Would you prefer a nice game of chess?",
    "A strange game. The only winning move is not to play.",
    "Wake up, Neo... The Matrix has you...",
    "Follow the white rabbit.",
    "Greetings, Programs!",
    "End of line.",
    "Open the pod bay doors, HAL.",
    "I'll be back.",
]

TYPE_DELAY = 0.025


def typewriter(text, delay=TYPE_DELAY, end="\n"):
    """Escribe carácter a carácter, como el terminal de WOPR."""
    for ch in text:
        sys.stdout.write(ch)
        sys.stdout.flush()
        if ch != " ":
            time.sleep(delay)
    sys.stdout.write(end)
    sys.stdout.flush()


class NoEcho:
    """Sin eco mientras sale la intro y carga el modelo: lo tecleado antes de
    tiempo no se pinta sobre el giro; readline lo recoge luego en el prompt."""

    def __enter__(self):
        try:
            self.saved = termios.tcgetattr(sys.stdin)
            attrs = termios.tcgetattr(sys.stdin)
            attrs[3] &= ~termios.ECHO
            termios.tcsetattr(sys.stdin, termios.TCSANOW, attrs)
        except (termios.error, ValueError, OSError):
            self.saved = None
        return self

    def __exit__(self, *exc):
        if self.saved is not None:
            termios.tcsetattr(sys.stdin, termios.TCSANOW, self.saved)


def server_ready():
    try:
        with urllib.request.urlopen(BASE + "/health", timeout=2) as r:
            return r.status == 200
    except (urllib.error.URLError, OSError):
        return False


def wait_for_server():
    """Espera a que llama-server termine de cargar el modelo."""
    if server_ready():
        return True
    sys.stdout.write("LOADING MODEL  ")  # el giro reescribe el último carácter
    sys.stdout.flush()
    spin = "|/-\\"
    for i in range(600):  # 5 minutos
        if server_ready():
            sys.stdout.write("\rLOADING MODEL ... OK\n")
            return True
        sys.stdout.write("\b" + spin[i % 4])
        sys.stdout.flush()
        time.sleep(0.5)
    sys.stdout.write("\rLOADING MODEL ... FAILED\n")
    print("The local model is not responding. Check: journalctl -u aios-llama")
    return False


class Context:
    """Presupuesto de contexto: sin recorte, al llenarse el contexto el
    servidor rechaza la petición y el chat solo daría ERROR hasta /clear.
    El tamaño es el del proveedor (el local lo dice su /props)."""

    def __init__(self, provider):
        self.n_ctx = aiconf.context_of(provider)
        self.chars_per_token = 3.0  # se ajusta con lo que mide el servidor

    def reply_tokens(self):
        return min(MAX_REPLY, self.n_ctx // 4)  # en contextos pequeños, menos reserva

    def budget(self):
        return min(int(self.n_ctx * HISTORY_SHARE), self.n_ctx - self.reply_tokens())

    def estimate(self, messages):
        chars = sum(len(m["content"]) for m in messages)
        return int(chars / self.chars_per_token) + 8 * len(messages)

    def calibrate(self, messages, prompt_tokens):
        chars = sum(len(m["content"]) for m in messages)
        if prompt_tokens and chars > 200:
            self.chars_per_token = max(1.5, min(6.0, chars / prompt_tokens))

    def trim(self, messages, force=False):
        """Quita los turnos más antiguos (nunca el sistema ni el último)."""
        dropped = 0
        while len(messages) > 2 and (force or self.estimate(messages) > self.budget()):
            del messages[1:3 if len(messages) > 3 else 2]  # un turno: usuario + respuesta
            dropped += 1
            force = False
        return dropped


def chat(messages, ctx, provider):
    """Envía la conversación y escribe la respuesta según llega (SSE)."""
    req_body = {
        "messages": messages,
        "stream": True,
        "stream_options": {"include_usage": True},
        "max_tokens": ctx.reply_tokens(),
    }
    if provider["local"]:
        # Sin razonamiento en el hito 0: en CPU cada token cuenta. Solo al
        # local: una API estricta rechaza parámetros que no conoce.
        req_body["chat_template_kwargs"] = {"enable_thinking": False}
    elif provider.get("model"):
        req_body["model"] = provider["model"]
    req = urllib.request.Request(
        provider["url"].rstrip("/") + "/chat/completions",
        data=json.dumps(req_body).encode(), headers=aiconf.headers(provider))
    reply = []
    t0 = time.monotonic()
    ntok = 0
    usage = timings = None
    with urllib.request.urlopen(req, timeout=600, context=aiconf.ssl_context(provider)) as r:
        for raw in r:
            line = raw.decode("utf-8", "replace").strip()
            if not line.startswith("data:"):
                continue
            data = line[5:].strip()
            if data == "[DONE]":
                break
            chunk = json.loads(data)
            usage = chunk.get("usage") or usage
            timings = chunk.get("timings") or timings
            choices = chunk.get("choices") or [{}]
            piece = choices[0].get("delta", {}).get("content") or ""
            if piece:
                ntok += 1
                reply.append(piece)
                sys.stdout.write(piece)
                sys.stdout.flush()
    dt = time.monotonic() - t0
    sys.stdout.write("\n")
    if usage:
        ctx.calibrate(messages, usage.get("prompt_tokens"))
    # Velocidad medida por el servidor; si no la da, la del reloj
    if timings and timings.get("predicted_n"):
        print(f"\033[2m[{timings['predicted_n']} tokens, "
              f"{timings.get('predicted_per_second', 0):.1f} tok/s]\033[0m")
    elif ntok and dt > 0:
        print(f"\033[2m[{ntok} tokens, {ntok / dt:.1f} tok/s]\033[0m")
    return "".join(reply)


def context_full(err):
    """¿Es el error de llama-server por contexto lleno?"""
    if not isinstance(err, urllib.error.HTTPError) or err.code != 400:
        return False
    try:
        body = err.read().decode("utf-8", "replace").lower()
    except OSError:
        return False
    return "context" in body or "exceed" in body


def main():
    os.system("clear")
    with NoEcho():
        typewriter("AIOS LOCAL TERMINAL")
        typewriter("LOGON: aios")
        print()
        typewriter(random.choice(QUOTES).upper(), delay=0.05)
        print()
        provider = aiconf.provider()
        if not provider["local"]:
            ok, err = aiconf.reachable(provider)
            if ok:
                print(f'REMOTE AI: {provider["name"]} ({provider["url"]})')
            else:
                print(f'REMOTE AI {provider["name"]} NOT REACHABLE ({err}). USING LOCAL MODEL.')
                provider = aiconf.provider("local")
        ready = provider["local"] is False or wait_for_server()
    if not ready:
        return 1
    print("Type a message. /clear starts over, /exit quits.\n")

    messages = [{"role": "system", "content": SYSTEM}]
    ctx = Context(provider)
    while True:
        try:
            text = input("> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if not text:
            continue
        if text in ("/exit", "/quit"):
            break
        if text == "/clear":
            messages = messages[:1]
            print("Conversation cleared.")
            continue
        messages.append({"role": "user", "content": text})
        forgot = ctx.trim(messages)
        for attempt in (1, 2):
            if forgot:
                print("\033[2m[older messages forgotten to make room]\033[0m")
            try:
                messages.append({"role": "assistant", "content": chat(messages, ctx, provider)})
            except KeyboardInterrupt:
                print("\n[interrupted]")
                messages.pop()
            except urllib.error.HTTPError as e:
                if attempt == 1 and context_full(e) and len(messages) > 2:
                    forgot = ctx.trim(messages, force=True)
                    continue
                print(f"\nERROR: {e}")
                messages.pop()
            except (urllib.error.URLError, OSError, ValueError) as e:
                print(f"\nERROR: {e}")
                messages.pop()
            break
    typewriter("END OF LINE.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
