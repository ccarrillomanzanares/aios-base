[Unit]
Description=AIOS update check (tells the desktop, installs nothing)
Documentation=file:/etc/aios/update.conf
# Sin network-online.target: wait-online espera a todas las interfaces (también
# la Ethernet sin cable) y fallaba a los 2 min. Sin red, se deja para mañana.

[Service]
Type=oneshot
ExecStart=/usr/bin/aios update code notify
# Que no compita con el modelo ni con la sesión
Nice=10
IOSchedulingClass=idle
