# =============================================================================
# AIOS — fragmento del kernel (x86_64), aplicado sobre kernel_base.config
#
# Heredado de newos, donde cada línea se verificó arrancando en hardware real.
# REGLA: aquí no se enumeran drivers. Los drivers vienen de la config base
# como módulos y udev los carga solos. Solo se integra (=y) lo imprescindible
# para montar la raíz SIN initramfs, que AIOS no usa.
# =============================================================================

# --- Identidad y arranque silencioso ----------------------------------------
CONFIG_LOCALVERSION="-aios"
CONFIG_DEFAULT_HOSTNAME="aios"
CONFIG_KERNEL_ZSTD=y
# CONFIG_LOGO is not set

# --- Latencia (voz) y rendimiento con poca RAM (IA local en 8 GB) ------------
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_IDLE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ZSWAP=y
CONFIG_NUMA=y

# --- systemd, contenedores y extensiones (sysext) ----------------------------
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Seguridad ---------------------------------------------------------------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y

# --- Medio de arranque propio: BIOS y UEFI, sin initramfs --------------------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_FB_EFI=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_MODULES=y
CONFIG_FW_LOADER=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- Almacenamiento integrado: sin initramfs, si es módulo no hay raíz -------
# (newos: arrancaba con disco IDE y pantalla negra con SATA mientras ahci era =m)
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
# (newos: sin xhci-pci integrado, la raíz en un pendrive no aparece nunca)
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y

# --- Máquinas virtuales de prueba (QEMU, VirtualBox) -------------------------
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VMWGFX=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# --- Lo heredado de Ubuntu que rompe el build o engorda el kernel ------------
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_MODULE_SIG=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_BTF=n
