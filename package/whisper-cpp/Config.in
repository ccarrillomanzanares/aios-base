config BR2_PACKAGE_WHISPER_CPP
	bool "whisper-cpp"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  Reconocimiento de voz local (Whisper) en CPU. Va en /opt/whisper
	  con su propio ggml: el de llama.cpp es de otra versión y las
	  bibliotecas libggml*.so chocarían en /usr/lib.

	  https://github.com/ggml-org/whisper.cpp
